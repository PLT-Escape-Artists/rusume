{
  // Base config from: https://github.com/withastro/astro/tree/main/packages/astro/tsconfigs
  "extends": "astro/tsconfigs/strictest",

  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "public/**/*",
    "src/**/*",
  ],

  "exclude": ["dist", "node_modules"],

  "compilerOptions": {
    // Path aliases for imports
    "paths": {
      "@src/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@assets/*": ["./src/assets/*"],
      "@pages/*": ["./src/pages/*"],
    },

    // Be strict with imported types
    "verbatimModuleSyntax": true,
  },
}
