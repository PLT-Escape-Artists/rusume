---
import Layout from '@layouts/Layout.astro';
---

<Layout>
    <article id='page-1'>
        <aside id='Left-Part'>
            <img src='/testfoto.jpg' alt='Bewerber Foto' />
            <section id='Contact'>
                <h3>KONTAKT</h3>
                <b>E-Mail</b>
                <a href='mailto:ruben.wenzel@freenet.de' target='_blank'>ruben.wenzel@freenet.de</a>

                <b>Telefon</b>
                <a href='tel:+49163832957' target='_blank'>+49 163 3832957</a>

                <b>Adresse</b>
                <a href='https://maps.app.goo.gl/ZiaQXwVpqXqSeRqz8' target='_blank'>
                    <address>Am Europakanal 38, <br /> 91056 Erlangen</address>
                </a>

                <b>Geburtsdatum</b>
                <b>19.11.2000</b>
            </section>
            <section id='Skills'>
                <h3>SKILLS</h3>
                <div>
                    <div>C#</div>
                    <div>C++</div>
                    <div>WPF</div>
                    <div>SQL</div>
                    <div>Web-Dev</div>
                    <div>Linux</div>
                    <div>Git</div>
                </div>
            </section>
            <section id='Language'>
                <h3>SPRACHEN</h3>
                <ul>
                    <li>Deutsch - Muttersprache</li>
                    <li>Englisch - B2 Niveau</li>
                </ul>
            </section>
        </aside>

        <div id='Right-Part'>
            <section id='Description'>
                <h1>Ruben Wenzel</h1>
                <p>
                    heiße ich und bin seit 2021 Software Entwickler im Bereich der Automatisierungsindustrie. <br />
                    Ich suche gerne Lösungen für interessante Probleme um passgenaue und pflegeleichte Software zu erstellen.
                </p>
            </section>
            <section id='Primary-Area'></section>
            <section id='Work-Experience'></section>
            <section id='Interests'></section>
        </div>

        <footer id='find-this-at'>
            Die aktuellste Version dieses Dokuments ist unter "<a href={import.meta.env.SITE} target='_blank'
                ><b>{import.meta.env.SITE}</b></a
            >" zu finden.
        </footer>
    </article>
</Layout>
